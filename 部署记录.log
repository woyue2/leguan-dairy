─────────────────────────────────────────────────────────────
💾 数据备份
─────────────────────────────────────────────────────────────
手动备份：
───────────────────────────────
docker run --rm \
  -v diary-data:/data \
  -v $(pwd):/backup \
  alpine \
  tar czf /backup/diary-backup-$(date +%Y%m%d).tar.gz -C /data .

自动备份脚本（服务器）：
───────────────────────────────
cat > /root/backup-diary.sh << 'SCRIPT'
#!/bin/bash
BACKUP_DIR="/root/diary-backups"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
mkdir -p "$BACKUP_DIR"

docker run --rm \
  -v diary-data:/data \
  -v "$BACKUP_DIR":/backup \
  alpine \
  tar czf /backup/diary-$TIMESTAMP.tar.gz -C /data .

echo "✅ 备份完成: diary-$TIMESTAMP.tar.gz"
find "$BACKUP_DIR" -name "diary-*.tar.gz" -mtime +30 -delete
SCRIPT

chmod +x /root/backup-diary.sh

# 添加到定时任务
crontab -e
# 添加: 0 2 * * * /root/backup-diary.sh >> /var/log/diary-backup.log 2>&1

